        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Telinga_berdenging"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Wajah_memerah"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Wajah_panas"/>
        <untitled-ontology-4:Deskripsi>Dapat mengobati malaria</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Klorokuin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Klorokuin">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antimalaria"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kram_perut"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Malaria"/>
        <untitled-ontology-4:Deskripsi>Mencegah dan mengatasi malaria, mengatasi amebiasis yang menyebar ke liver, rheumatoid arthritis, dan lupus</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Konjungtivitis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Konjungtivitis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Genoint_tetes_mata"/>
        <untitled-ontology-4:Deskripsi>Konjungtivitis adalah mata merah akibat peradangan pada selaput yang melapisi permukaan bola mata dan kelopak mata bagian dalam (konjungtiva mata). Selain mata merah, konjungtivitis dapat disertai rasa gatal pada mata dan mata berair.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kram_perut -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kram_perut">
