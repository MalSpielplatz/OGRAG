        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sulfamethoxazole"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bronkitis"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Demam"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pneumonia"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sinusitis"/>
        <untitled-ontology-4:Deskripsi>Fasiprim adalah obat untuk mengatasi berbagai infeksi bakteri</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Feses_berwarna_seperti_tanah_liat -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Feses_berwarna_seperti_tanah_liat">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Folikulitis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Folikulitis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Biogen"/>
        <untitled-ontology-4:Deskripsi>Folikulitis adalah peradangan pada folikel rambut atau tempat rambut tumbuh. Kondisi ini biasanya disebabkan oleh infeksi bakteri atau jamur. Meski sering kali tidak berbahaya, folikulitis bisa memburuk dan menyebabkan rambut hilang secara permanen.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Genoint_tetes_mata -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Genoint_tetes_mata">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aminoglikosida"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetes"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Gentamicin"/>
        <untitled-ontology-4:Deskripsi>Genoint tetes mata adalah obat untuk mengatasi infeksi bakteri di mata maupun kelopak mata, seperti konjungtivitis bakterial atau blefaritis. Tetes mata merek Genoint mengandung antibiotik gentamicin yang mampu membasmi kuman penyebab infeksi mata. Obat mata ini hanya bisa diperoleh dengan resep dokter.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Gentamicin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Gentamicin">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aminoglikosida"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infus"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Suntik"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Hilang_selera_makan"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mudah_lelah"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penglihatan_buram"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Hilang_selera_makan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Hilang_selera_makan">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Histoplasmosis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Histoplasmosis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Itraconazole"/>
        <untitled-ontology-4:Deskripsi>Histoplasmosis adalah penyakit infeksi yang disebabkan oleh spora jamur Histoplasma capsulatum. Seseorang bisa terkena histoplasmosis ketika tidak sengaja menghirup udara yang terkontaminasi spora jamur tersebut. Meski begitu, histoplasmosis tidak menular antarmanusia.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Impetigo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Impetigo">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Biogen"/>
        <untitled-ontology-4:Deskripsi>Impetigo adalah infeksi kulit menular yang banyak dialami oleh bayi dan anak-anak. Infeksi ini ditandai dengan kemunculan bercak merah dan lepuhan di kulit, terutama di wajah, tangan, dan kaki.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Librocef"/>
        <untitled-ontology-4:Deskripsi>Infeksi saluran kemih adalah kondisi ketika organ yang termasuk dalam sistem kemih mengalami infeksi. Organ tersebut bisa meliputi ginjal, saluran kencing, atau kandung kemih. Namun, sebagian besar infeksi saluran kemih terjadi pada saluran kencing dan kandung kemih.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Abbotic"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ampicillin"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Baquinor"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bernoflox"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Broadamox"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ciprofloxacin"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Fasiprim"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Librocef"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Lincomycin"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Meropenem"/>
        <untitled-ontology-4:Deskripsi>Infeksi saluran pernapasan adalah infeksi yang terjadi di saluran pernapasan, bisa atas atau bawah. Meski biasanya dapat sembuh tanpa perawatan khusus, kondisi ini bisa berbahaya bagi anak-anak, lansia, atau orang dengan daya tahan tubuh yang lemah.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infus -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infus">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#BentukObat"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Insomnia -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Insomnia">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:Deskripsi>Insomnia adalah gangguan tidur yang membuat penderitanya sulit tidur atau sering terbangun saat tidur dan sulit untuk tertidur kembali. Insomnia yang parah bisa menurunkan kualitas hidup sehingga berdampak buruk pada kesehatan dan keselamatan penderitanya.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Interdoxin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Interdoxin">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetracycline"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Doxycycline"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Itraconazole -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Itraconazole">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Azole"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Perut_kembung"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pusing"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:Deskripsi>Itraconazole adalah obat untuk mengatasi infeksi jamur di berbagai bagian dan area tubuh. Obat ini juga dapat digunakan untuk mencegah infeksi jamur pada seseorang dengan sistem imun yang lemah</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Jerawat -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Jerawat">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetracycline_Hcl"/>
        <untitled-ontology-4:Deskripsi>Jerawat adalah masalah kulit yang terjadi ketika pori-pori kulit, tepatnya folikel rambut, tersumbat oleh kotoran, debu, minyak, atau sel kulit mati. Akibatnya, terjadi peradangan pada pori-pori tersebut dan bisa juga disertai infeksi. Jerawat sering muncul di wajah, leher, punggung, atau dada.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kandidiasis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kandidiasis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Anidulafungin"/>
        <untitled-ontology-4:Deskripsi>kandidiasis adalah infeksi jamur yang disebabkan oleh jamur Candida albicans.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kaplet -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kaplet">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#BentukObat"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#BentukObat"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keputihan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keputihan">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:Deskripsi>Keputihan adalah kondisi ketika lendir kental atau cairan bening keluar dari vagina. Keputihan merupakan cara alami tubuh untuk menjaga kebersihan, kelembapan, serta untuk melindungi organ intim wanita dari infeksi.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keringat_berlebihan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keringat_berlebihan">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ketoconazole -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ketoconazole">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Azole"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tablet"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pusing"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
        <untitled-ontology-4:Deskripsi>Ketoconazole adalah obat untuk mengatasi infeksi jamur yang menyerang organ dalam tubuh atau infeksi jamur sistemik. Ketoconazole hanya digunakan pada infeksi jamur sistemik yang berat atau tidak membaik dengan obat antijamur lain.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kina -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kina">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antimalaria"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Suntik"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tablet"/>
