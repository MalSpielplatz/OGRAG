     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:untitled-ontology-4="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#">
