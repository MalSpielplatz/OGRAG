    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amebiasis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amebiasis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Paromomycin"/>
        <untitled-ontology-4:Deskripsi>Amebiasis adalah infeksi usus yang disebabkan oleh parasit Entamoeba histolytica. Penyakit ini sering ditemukan di negara tropis dan berkembang dengan kondisi sanitasi yang kurang baik, termasuk Indonesia. Meskipun dapat menimbulkan gejala serius, amebiasis bisa diobati dengan tepat.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


