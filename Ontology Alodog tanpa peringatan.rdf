    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Deskripsi -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Deskripsi">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aminoglikosida -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aminoglikosida">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Aminoglikosida adalah jenis antibiotik yang biasa digunakan untuk mengatasi amebiasis, bakteremia, infeksi tulang, brucellosis, kriptosporidiosis, fibrosis kistik, diare, meningitis, tuberkulosis, atau infeksi ginjal. Antibiotik ini juga berguna untuk mencegah endokarditis bakterial.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amphenicol -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amphenicol">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Antibiotik golongan amphenicol dapat digunakan untuk berbagai infeksi bakteri, termasuk infeksi pada saluran pencernaan.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Analgesik-Antipiretik -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Analgesik-Antipiretik">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat"/>
        <rdfs:comment rdf:nodeID="genid3"/>
    </owl:Class>
    <rdf:Description rdf:nodeID="genid3">
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
        <untitled-ontology-4:Deskripsi>Analgetik dan antipiretik adalah golongan obat yang berfungsi sebagai penurun demam sekaligus pereda nyeri. Beberapa jenis obat analgetik-antipiretik bisa dibeli bebas di apotek. Meski begitu, penggunaan obat golongan ini tidak boleh sembarangan dan harus sesuai dengan aturan kemasan atau anjuran dokter.</untitled-ontology-4:Deskripsi>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Antibiotik adalah obat untuk mengatasi atau mencegah infeksi bakteri. Obat ini tidak dapat digunakan untuk mengatasi infeksi akibat virus, seperti flu. Perlu diingat, antibiotik hanya boleh dikonsumsi atas anjuran dari dokter.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antijamur -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antijamur">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Antijamur adalah kelompok obat yang bermanfaat untuk mengatasi infeksi jamur. Obat antijamur atau antifungi ini tersedia dalam berbagai bentuk sediaan, mulai dari tablet, krim, salep, suntik, hingga sampo.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antimalaria -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antimalaria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat"/>
        <rdfs:comment rdf:nodeID="genid6"/>
    </owl:Class>
    <rdf:Description rdf:nodeID="genid6">
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pendengaran_berkurang"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penglihatan_buram"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pusing"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Telinga_berdenging"/>
        <untitled-ontology-4:Deskripsi>Antimalaria adalah kelompok obat untuk mengobati dan mencegah malaria. Malaria adalah penyakit infeksi yang disebabkan oleh parasit Plasmodium dan menular melalui gigitan nyamuk Anopheles.</untitled-ontology-4:Deskripsi>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Azole -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Azole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antijamur"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Obat ini merupakan antijamur berspektrum luas sehingga dapat membunuh berbagai jenis jamur. Antijamur golongan azole bekerja dengan cara merusak membran sel jamur. Jika membran sel jamur rusak, sel tersebut akan mati.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#BentukObat -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#BentukObat"/>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Carbapenem -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Carbapenem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Obat antibiotik golongan carbapenem bisa digunakan untuk menangani berbagai penyakit akibat infeksi bakteri. Antibiotik carbapenem biasanya digunakan ketika antibiotik lain sudah tidak ampuh menangani infeksi.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Echinocandin -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Echinocandin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antijamur"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Obat"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Glicopeptide -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Glicopeptide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Glicopeptide adalah jenis antibiotik yang biasa digunakan untuk mengatasi diare yang disebabkan oleh bakteri Clostridium difficile.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#KategoriObat"/>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Lincosamide -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Lincosamide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Antibiotik golongan lincosamide digunakan untuk mengobati dan mencegah beberapa kondisi akibat infeksi bakteri.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Makrolid -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Makrolid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Obat"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Obat -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Obat"/>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penisilin -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penisilin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Polyene -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Polyene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antijamur"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Quinolone -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Quinolone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Quinolone digunakan untuk mengatasi anthrax, penyakit pes, infeksi saluran kemih yang berat atau berulang, pneumonia, infeksi kulit dan jaringan lunak, infeksi ginjal, prostatitis, penyakit radang panggul, atau infeksi tulang dan sendi.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sefalosporin -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sefalosporin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Beberapa kondisi yang dapat diobati menggunakan sefalosporin adalah infeksi tulang, otitis media, infeksi kulit, infeksi saluran pernapasan atas, dan infeksi saluran kemih.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sulfonamida -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sulfonamida">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Antibiotik golongan sulfa bisa digunakan untuk menangani infeksi saluran kemih, bronkitis, meningitis bakterial, pneumonia, serta infeksi mata atau telinga.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetracycline -->

    <owl:Class rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetracycline">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Antibiotik"/>
        <rdfs:comment>
            <rdf:Description>
                <untitled-ontology-4:Deskripsi>Tetrasiklin digunakan untuk mengobati beberapa kondisi, di antaranya anthrax, periodontitis, infeksi pada mata, dan jerawat atau rosacea yang parah. Tetrasiklin jenis tertentu tidak dapat digunakan pada anak usia di bawah 8 tahun.</untitled-ontology-4:Deskripsi>
            </rdf:Description>
        </rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Abbotic -->

