    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aspergillosis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aspergillosis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Itraconazole"/>
        <untitled-ontology-4:Deskripsi>Aspergillosis adalah penyakit infeksi yang disebabkan oleh jamur Aspergillus. Penyakit infeksi jamur ini umumnya memengaruhi sistem pernapasan, tetapi juga dapat menyebar ke bagian tubuh lain, seperti kulit, mata, atau otak.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Baquinor -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Baquinor">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Quinolone"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infus"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kaplet"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tablet"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Insomnia"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pusing"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ciprofloxacin"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pneumonia"/>
        <untitled-ontology-4:Deskripsi>Baquinor adalah obat untuk mengatasi berbagai infeksi bakteri</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Batuk -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Batuk">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#EfekSamping"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:Deskripsi>Batuk adalah respons alami tubuh untuk mengeluarkan benda asing dari dalam saluran pernapasan, seperti debu, kuman, atau virus. Namun, jika terjadi berkepanjangan dan disertai keluhan lain, batuk bisa menjadi gejala gangguan pernapasan, mulai dari asma, tuberkulosis, hingga kanker paru-paru.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bernoflox -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bernoflox">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Quinolone"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tablet"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keputihan"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Maag"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mudah_lelah"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ciprofloxacin"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan"/>
        <untitled-ontology-4:Deskripsi>Bernoflox adalah obat untuk mengatasi berbagai penyakit akibat infeksi bakteri.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bintamox -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bintamox">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penisilin"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kaplet"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sirop"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Insomnia"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ruam_kulit"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amoxicillin"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bronkitis"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pneumonia"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sinusitis"/>
        <untitled-ontology-4:Deskripsi>Bintamox adalah antibiotik yang berguna untuk mengatasi berbagai infeksi bakteri. Beberapa infeksi bakteri yang bisa diatasi dengan obat ini adalah infeksi kulit, sinusitis, bronkitis, hingga pneumonia. Bintamox mengandung bahan aktif amoxicillin.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Biogen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Biogen">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Aminoglikosida"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Krim"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kulit_gatal-gatal"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kulit_memerah"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Gentamicin"/>
        <untitled-ontology-4:Deskripsi>Biogen adalah obat oles untuk mengatasi infeksi kulit akibat bakteri, seperti impetigo, folikulitis, atau bisul. Obat ini mampu membasmi bakteri penyebab infeksi sekaligus meredakan keluhan yang timbul karena infeksi tersebut.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Blefaritis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Blefaritis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Genoint_tetes_mata"/>
        <untitled-ontology-4:Deskripsi>Blefaritis adalah peradangan di kelopak mata. Kondisi ini dapat menyebabkan kelopak mata bengkak, kemerahan, dan terasa nyeri. Meski begitu, blefaritis umumnya bukanlah kondisi yang serius dan tidak menular.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Broadamox -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Broadamox">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penisilin"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kaplet"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sirop"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Insomnia"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pusing"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Ruam_kulit"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Amoxicillin"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_kemih"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Infeksi_saluran_pernapasan"/>
        <untitled-ontology-4:Deskripsi>Broadamox adalah antibiotik untuk mengobati infeksi bakteri di berbagai bagian tubuh. Obat yang memiliki kandungan amoxicillin ini tersedia dalam bentuk kaplet dan sirop kering. Broadamox bisa diperoleh setelah berkonsultasi dengan dokter.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bronkitis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Bronkitis">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Penyakit"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Clarithomycin"/>
        <untitled-ontology-4:memilikiPengobatan rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Paracetamol"/>
        <untitled-ontology-4:Deskripsi>Bronkitis adalah iritasi atau peradangan pada dinding saluran bronkus, yaitu pipa yang menyalurkan udara dari tenggorokan ke paru-paru. Kondisi ini umumnya disebabkan oleh infeksi virus atau iritasi akibat paparan asap rokok dan polusi udara. Bronkitis bisa berlangsung dalam hitungan hari, minggu, bahkan bulan.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cazetin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cazetin">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Merk"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Polyene"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tetes"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_perut"/>
        <untitled-ontology-4:memilikiKandunganAktif rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Nystatin"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kandidiasis"/>
        <untitled-ontology-4:Deskripsi>Cazetin adalah obat antijamur berbahan aktif nystatin. Cazetin bermanfaat untuk mengobati infeksi jamur kandidiasis</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cefaclor -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cefaclor">
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Generik"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sefalosporin"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Kapsul"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sirop"/>
        <untitled-ontology-4:memilikiBentuk rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Tablet"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Diare"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Keputihan"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Maag"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Mual"/>
        <untitled-ontology-4:memilikiEfekSamping rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Sakit_kepala"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Faringitis"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Pneumonia"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Radang_amandel"/>
        <untitled-ontology-4:Deskripsi>Cefaclor adalah obat antibiotik untuk mengatasi berbagai penyakit akibat infeksi bakteri, mulai dari radang tenggorokan (faringitis) hingga infeksi saluran kemih. Cefaclor tersedia dalam bentuk tablet, kapsul, dan sirop kering, yang bisa dibeli dengan resep dokter.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cefadroxil -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Cefadroxil">
