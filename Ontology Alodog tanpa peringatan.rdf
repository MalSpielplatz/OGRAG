        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Demam"/>
        <untitled-ontology-4:obatPenyakit rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Meningitis"/>
        <untitled-ontology-4:Deskripsi>Chloramphenicol atau kloramfenikol adalah antibiotik yang dapat digunakan untuk mengobati infeksi bakteri di berbagai bagian tubuh. Obat ini hanya boleh digunakan dengan resep dokter.</untitled-ontology-4:Deskripsi>
    </owl:NamedIndividual>
    


