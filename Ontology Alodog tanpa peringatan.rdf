    <!-- http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#memilikiKategori -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#memilikiKategori">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cobaa/ontologies/2025/6/untitled-ontology-4#Obat"/>
